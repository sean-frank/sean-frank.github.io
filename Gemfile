source "https://rubygems.org"

# Pins the same major GitHub Pages stack used in production (Jekyll 3.10).
# GitHub Pages builds with its own environment and does not run this Gemfile.
gem "github-pages", "~> 232", group: :jekyll_plugins
# Silences a Faraday 2 warning from the GitHub metadata client during local builds.
gem "faraday-retry"
